 bool sensor::EChem_CA::processAndStoreData(uint32_t* pData, uint32_t numSamples) {
-  return techniqueRuntime::forEachAdcCode(pData, numSamples, [this](uint32_t adcCode) {
-    push(calculateCurrent(adcCode, config.ADCPgaGain, config.ADCRefVolt, config.RtiaCalValue.Magnitude));
+  // FIFO words are drained in bursts. Acquisition time is reconstructed from the
+  // drain time and the nominal sampling interval, so it carries the wakeup-timer
+  // tolerance; it is not a per-conversion hardware timestamp.
+  const uint32_t drainMs = millis();
+  const uint32_t periodMs = static_cast<uint32_t>(lroundf(config.SamplingIntervalS * 1000.0f));
+  const float dieC = readCPUTemperature(); // nRF52 die, 0.25 C steps
+
+  uint32_t index = 0;
+  return techniqueRuntime::forEachAdcCode(pData, numSamples, [&](uint32_t adcCode) {
+    ock_sample_t sample = {};
+    sample.seq = sampleSeq;
+    sample.t_ms = drainMs - (numSamples - 1u - index) * periodMs;
+    sample.current_pa = static_cast<int32_t>(
+        lroundf(calculateCurrent(adcCode, config.ADCPgaGain, config.ADCRefVolt, config.RtiaCalValue.Magnitude) *
+                1.0e6f));
+    sample.temp_cc = static_cast<int16_t>(lroundf(dieC * 100.0f));
+    sample.status = static_cast<uint8_t>((identEpoch << OCK_ST_EPOCH_SHIFT) | OCK_ST_TEMP_DIE);
+    if (adcCode == 0u || adcCode == 0xffffu) sample.status |= OCK_ST_OVERRANGE;
+    if (static_cast<int32_t>(sample.t_ms - startMs) < static_cast<int32_t>(kCASettleMs)) sample.status |= OCK_ST_SETTLING;
+
+    OckFrameBytes frame;
+    ock_encode_sample(frame.bytes, &sample);
+    push(frame);
+    sampleSeq++;
+    if (sampleSeq % kCAIdentRepeatSamples == 0u) pushIdent();
+    index++;
   });
 }
