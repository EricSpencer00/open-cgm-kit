+bool sensor::EChem_CA::rtiaCodeFromKohm(uint16_t kohm, uint32_t* code) {
+  static const struct {
+    uint16_t kohm;
+    uint32_t code;
+  } table[] = {{10, LPTIARTIA_10K},   {12, LPTIARTIA_12K},   {16, LPTIARTIA_16K},   {20, LPTIARTIA_20K},
+               {24, LPTIARTIA_24K},   {30, LPTIARTIA_30K},   {32, LPTIARTIA_32K},   {40, LPTIARTIA_40K},
+               {48, LPTIARTIA_48K},   {64, LPTIARTIA_64K},   {85, LPTIARTIA_85K},   {96, LPTIARTIA_96K},
+               {100, LPTIARTIA_100K}, {120, LPTIARTIA_120K}, {128, LPTIARTIA_128K}, {160, LPTIARTIA_160K},
+               {196, LPTIARTIA_196K}, {256, LPTIARTIA_256K}, {512, LPTIARTIA_512K}};
+  for (const auto& entry : table) {
+    if (entry.kohm == kohm) {
+      *code = entry.code;
+      return true;
+    }
+  }
+  return false;
+}
+
+void sensor::EChem_CA::pushIdent(void) {
+  ock_ident_t id = {};
+  id.status = static_cast<uint8_t>(identEpoch << OCK_ST_EPOCH_SHIFT);
+  id.technique = 1u;
+  id.rtia_x10 = static_cast<uint16_t>(rtiaKohm * 100u);
+  id.bias_mv = static_cast<int16_t>(lroundf(config.SensorBias));
+  id.period_ms = static_cast<uint16_t>(fminf(config.SamplingIntervalS * 1000.0f, 65535.0f));
+  id.sensor_id = sensorId;
+  id.cal_id = calId;
+  OckFrameBytes frame;
+  ock_encode_ident(frame.bytes, &id);
+  push(frame);
+}
